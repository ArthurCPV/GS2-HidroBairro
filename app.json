{
  "expo": {
    "name": "GS2-HidroBairro",
    "slug": "GS2-HidroBairro",
    "version": "1.0.0",
    "scheme": "hidrobairro",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-system-ui",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sua localização será usada somente para centralizar o mapa enquanto você usa o HidroBairro."
        }
      ],
      "expo-secure-store"
    ]
  }
}
